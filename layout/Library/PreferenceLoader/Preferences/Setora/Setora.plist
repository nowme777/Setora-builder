<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>title</key><string>Setora</string>
	<key>entry</key>
	<dict>
		<key>cell</key><string>PSLinkCell</string>
		<key>label</key><string>Setora</string>
	</dict>
	<key>items</key>
	<array>
		<dict>
			<key>cell</key><string>PSGroupCell</string>
			<key>label</key><string>Основные настройки</string>
			<key>footerText</key><string>После изменения параметров полностью закройте приложение «Настройки» и откройте его снова.</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSwitchCell</string>
			<key>defaults</key><string>com.nowme.setora</string>
			<key>key</key><string>enabled</string>
			<key>default</key><true/>
			<key>label</key><string>Включить Setora</string>
			<key>PostNotification</key><string>com.nowme.setora/preferences.changed</string>
		</dict>
		<dict>
			<key>cell</key><string>PSEditTextCell</string>
			<key>defaults</key><string>com.nowme.setora</string>
			<key>key</key><string>customTitle</string>
			<key>label</key><string>Название «Настроек»</string>
			<key>placeholder</key><string>Настройки</string>
			<key>PostNotification</key><string>com.nowme.setora/preferences.changed</string>
		</dict>
		<dict>
			<key>cell</key><string>PSEditTextCell</string>
			<key>defaults</key><string>com.nowme.setora</string>
			<key>key</key><string>textColor</string>
			<key>label</key><string>Цвет текста HEX</string>
			<key>placeholder</key><string>#007AFF</string>
			<key>PostNotification</key><string>com.nowme.setora/preferences.changed</string>
		</dict>
	</array>
</dict>
</plist>
